{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visual_check",
    "action",
    "bbox_2d",
    "target",
    "target_type",
    "estimated_distance_m",
    "target_center_normalized",
    "target_center_pixel",
    "horizontal_offset_pixel",
    "camera_bearing_deg",
    "rotation_direction",
    "rotation_angle_deg",
    "confidence",
    "distance_confidence",
    "stop_reasoning"
  ],
  "properties": {
    "visual_check": {"type": "string"},
    "action": {"type": "string", "enum": ["NAVIGATE", "STOP"]},
    "bbox_2d": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1000}
        }
      ]
    },
    "target": {"type": "string"},
    "target_type": {
      "type": "string",
      "enum": ["global_target", "intermediate_landmark", "traversable_opening"]
    },
    "estimated_distance_m": {
      "anyOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]
    },
    "target_center_normalized": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1000}
        }
      ]
    },
    "target_center_pixel": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": 0}
        }
      ]
    },
    "horizontal_offset_pixel": {"type": ["number", "null"]},
    "camera_bearing_deg": {"type": ["number", "null"]},
    "rotation_direction": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "enum": ["LEFT", "RIGHT", "CENTERED"]}
      ]
    },
    "rotation_angle_deg": {
      "anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "distance_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "stop_reasoning": {"type": "string"}
  }
}
